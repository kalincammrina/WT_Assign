<%@ page contentType="text/html;charset=UTF-8" %><%! private String h(Object v){if(v==null)return "";return v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %><!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Portal Login</title><link rel="stylesheet" href="portal.css"></head><body><main class="login-shell"><div class="login-art"><div class="brand">CAMPUSFLOW</div><div><span class="tag">STUDENT SERVICES</span><h1>One campus.<br><i>Every possibility.</i></h1><p>Access verified student profiles and their supporting documents in one secure space.</p></div><div class="art-foot">STUDENT INFORMATION PORTAL · 2026</div></div><section class="login-panel"><div class="login-box"><div class="mini-icon">C</div><span class="tag">WELCOME BACK</span><h2>Sign in to portal</h2><p>Enter your administrator credentials to continue.</p><% if(request.getAttribute("error")!=null){ %><div class="alert"><%=h(request.getAttribute("error"))%></div><% } %><form method="post" action="login"><label>Username<input name="username" placeholder="admin" required></label><label>Password<input type="password" name="password" placeholder="Enter your password" required></label><button>Continue to portal <span>→</span></button></form><small>Protected access · Authorized users only</small></div></section></main></body></html>
